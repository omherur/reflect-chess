generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The application's record of a person. Identity itself lives in Supabase
// Auth — this row exists so games, reflections and Chess.com links have
// something local to hang off, and is created the first time an
// authenticated user is seen (see src/server/auth.ts).
model User {
  id             String         @id @default(cuid())
  // Display name only. No longer unique and no longer a login identifier:
  // two people may reasonably both be "Om", and identity is proven by
  // Supabase now, not by typing a name.
  name           String
  // The Supabase auth user id — the stable link between this row and the
  // identity. Nullable because local fixtures and the seed script create
  // users that never authenticate; a real signed-in user always has one.
  supabaseUserId String?        @unique
  // Mirrored from Supabase for display and the admin view, so listing
  // accounts doesn't require a call out to the auth API.
  email          String?        @unique
  createdAt      DateTime       @default(now())
  accounts       ChessAccount[]
  games          Game[]

  // Stripe Billing. Stripe is the source of truth for every field below;
  // these columns are a local mirror kept in step by the webhook, so
  // rendering a page never costs a call out to the Stripe API. The customer
  // id is written before Checkout starts, so the customer -> user mapping
  // already exists even if the webhook lands before the browser redirects
  // back.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Stripe's own status string, stored verbatim rather than reduced to a
  // boolean: "past_due" has to be distinguishable from "canceled" because
  // one keeps access and the other doesn't (see src/lib/plans.ts).
  // Null means this account has never subscribed.
  subscriptionStatus   String?
  subscriptionPriceId  String?
  // End of the paid period. Read from the subscription's ITEM, not the
  // subscription — see src/server/billing/sync.ts.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
}

model ChessAccount {
  id           String    @id @default(cuid())
  platform     String // "chesscom" (lichess later)
  username     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set after each successful auto-sync, so future syncs can report "N new
  // games" instead of just re-checking everything from scratch.
  lastSyncedAt DateTime?

  @@unique([platform, username, userId])
}

model Game {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String // "chesscom" | "manual"
  externalId  String // platform game id, or PGN hash for manual imports
  pgn         String
  whitePlayer String
  blackPlayer String
  userColor   String // "white" | "black"
  result      String // "1-0" | "0-1" | "1/2-1/2" | "*"
  playedAt    DateTime?
  timeControl String?
  opening     String?

  // PENDING | ANALYZING | ANALYZED | FAILED
  analysisStatus   String  @default("PENDING")
  analysisProgress Int     @default(0) // 0-100
  analysisError    String?

  // How the game ended, classified from the PGN's Termination header:
  // checkmate | resignation | timeout | abandoned | agreement | other | null (unknown)
  terminationReason String?

  // The user's own rating for this game, parsed from the PGN's WhiteElo/
  // BlackElo header (whichever side the user played). Null for manually
  // pasted PGNs without rating headers.
  userRating Int?

  // Post-game summary — generated once, lazily, the first time every key
  // moment in the game has been reviewed (see src/server/summary). Cached
  // here rather than regenerated on every visit to the summary page, same
  // reasoning as Reflection.explanation being generated once and stored.
  // JSON-serialized StructuredGameSummary.
  summary            String?
  summaryGeneratedAt DateTime?

  // When this game consumed one of its owner's monthly analysis allowance.
  // Written once, at dispatch, by POST /api/games/[id]/analyze, and only
  // when it is null — so re-analysing a game you already paid for is free,
  // forever. Cleared again if the analysis run fails, so a crashed engine
  // isn't billed. The seeded demo game never has one: it's inserted
  // pre-analyzed and never passes through the route, so it costs nothing
  // and counts for nothing.
  analysisChargedAt DateTime?

  createdAt  DateTime    @default(now())
  moves      GameMove[]
  keyMoments KeyMoment[]

  @@unique([userId, platform, externalId])
  // The monthly usage count is a range scan over exactly this pair.
  @@index([userId, analysisChargedAt])
}

model GameMove {
  id           String      @id @default(cuid())
  gameId       String
  game         Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply          Int // 1-based half-move index
  moveNumber   Int
  color        String // "white" | "black"
  san          String
  uci          String
  fenBefore    String
  fenAfter     String
  // Seconds remaining on the mover's clock AFTER this move, parsed from the
  // PGN's %clk annotations when present (e.g. Chess.com imports).
  clockSeconds Int?
  keyMoments   KeyMoment[]

  @@unique([gameId, ply])
}

model KeyMoment {
  id     String   @id @default(cuid())
  gameId String
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moveId String
  move   GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)

  sortIndex Int // order within the game review (0-based)
  ply       Int
  fen       String // position before the move was played

  originalSan String
  originalUci String
  bestMoveSan String
  bestMoveUci String

  // Evaluations are centipawns from White's perspective; mate distances override cp.
  evalBeforeCp   Int?
  evalBeforeMate Int?
  evalAfterCp    Int?
  evalAfterMate  Int?

  selectionReason    String
  classification     String // BEST | GOOD | INACCURACY | MISTAKE | BLUNDER | MISSED_OPPORTUNITY | FORCED
  principalVariation String // JSON array of SAN moves for the best line
  conceptHighlights  String @default("[]") // JSON array of {concept, note, squares}

  // Importance ranking, computed at analysis time.
  importanceScore Int    @default(0) // 0-100
  importanceTier  String @default("MINOR") // CRITICAL | NOTABLE | MINOR

  // PENDING | REVIEWED
  reviewStatus String      @default("PENDING")
  reflection   Reflection?
  createdAt    DateTime    @default(now())

  @@unique([gameId, sortIndex])
}

model Reflection {
  id          String    @id @default(cuid())
  keyMomentId String    @unique
  keyMoment   KeyMoment @relation(fields: [keyMomentId], references: [id], onDelete: Cascade)

  thoughts      String // raw free-text reasoning captured before reveal
  replaySame    Boolean @default(false) // user chose "I'd play the same move"
  replayMoveSan String
  replayMoveUci String

  // How confident the player felt in the move, 1 (a total guess) to 5 (certain) —
  // captured before reveal, alongside the reasoning and replay move. Default
  // only exists so adding this column to existing rows doesn't require a
  // backfill; new submissions always provide it (enforced in the API route).
  confidence Int @default(3)

  // Optional, multi-select quick-tags describing the thinking that led to
  // this move (e.g. "I was rushing"). JSON array of strings.
  tags String @default("[]")

  // A single adaptive follow-up question, generated when the initial
  // reasoning was too thin to learn anything from, asked at most once per
  // key moment. Null/empty when the initial answer was already substantive.
  followUpQuestion String?
  followUpAnswer   String?

  replayEvalCp   Int?
  replayEvalMate Int?
  replayVerdict  String? // IMPROVEMENT | SAME_AS_ORIGINAL | SAME_AS_BEST | WORSE | SIMILAR

  // Generated only once both reflection questions are answered — it's
  // personalized to this specific reasoning + replay move, so it can't be
  // computed any earlier. JSON-serialized StructuredExplanation.
  explanation String @default("{}")

  createdAt DateTime @default(now())
}

// Engine analysis cache, keyed by position + analysis settings.
model AnalysisCache {
  id        String   @id @default(cuid())
  fen       String
  settings  String // e.g. "d12mpv3"
  result    String // JSON-serialized engine result
  createdAt DateTime @default(now())

  @@unique([fen, settings])
}

// A pre-launch email signup from the landing page. Deliberately not tied to
// User — someone joining the waitlist hasn't created an account, and may
// never; the two lists are independent.
model WaitlistSignup {
  id        String   @id @default(cuid())
  // Stored normalized (trimmed + lowercased) so the unique constraint
  // actually dedupes — "Me@Example.com " and "me@example.com" are one person.
  email     String   @unique
  // Which CTA the signup came from, so separate placements can be compared
  // later without a schema change.
  source    String   @default("landing")
  createdAt DateTime @default(now())
}

// One row per Stripe webhook event we've already acted on.
//
// Stripe retries a failed delivery for up to 3 days and makes no ordering
// guarantee, so the same event arrives more than once as a matter of course.
// Inserting the event's own id first, and treating a unique-constraint
// collision as "already handled", is what makes a redelivery a no-op rather
// than a double-provision — the same idempotent framing as WaitlistSignup's
// upsert.
model StripeEvent {
  id          String   @id // Stripe's own evt_... id
  type        String
  processedAt DateTime @default(now())
}
