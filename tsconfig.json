{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // lumos/ is a separate, self-contained Next scaffold that happens to
    // sit inside this directory. It has its own tsconfig, package.json and
    // lockfile, and its own "~/*" path alias that resolves against ITS
    // config, not this one — so the "**/*.tsx" include above was pulling it
    // in and failing the build on imports that are perfectly valid over
    // there. Nothing in src/ references it.
    "lumos"
  ]
}
