DATABASE_URL="file:./dev.db"

# Required for real, position-specific AI explanations (Claude Sonnet).
# Without it, every explanation silently falls back to the deterministic
# template provider — the app still works, but explanations get noticeably
# generic and repetitive across unrelated positions. If you notice the same
# sentence appearing verbatim on different moves, check this is actually set
# and check the server logs for "[explain]" warnings.
ANTHROPIC_API_KEY=

# Comma-separated allowlist of emails that may see /admin (signups +
# waitlist). Matched against the address Supabase authenticated, so it
# cannot be spoofed from inside the app. Leave unset and /admin is closed
# to everyone, including you.
ADMIN_EMAILS=

# Supabase project, used for email/password auth only — app data still lives
# in the local Prisma/SQLite database. Both values are safe to expose to the
# browser (that's what NEXT_PUBLIC_ means); the publishable key is not a
# secret, it's the client-side key protected by Supabase's own policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in is configured in the Supabase dashboard, NOT here:
# Authentication → Providers → Google, with the OAuth client id and secret
# from Google Cloud Console. The app only names the provider, so there is no
# Google client id or secret in this file by design.
#
# Two redirect URLs have to line up or the flow breaks at the last step:
#   Google Cloud Console → Authorized redirect URI:
#     https://<project-ref>.supabase.co/auth/v1/callback
#   Supabase → Authentication → URL Configuration → Redirect URLs:
#     http://localhost:3000/auth/callback   (plus your production URL)

# Stripe Billing — the paid plan ($8/month for 30 analyzed games; free
# accounts get 5). Analysis is what's metered, not importing: a game analyzed
# means a full engine scan plus a written explanation per key moment, whereas
# importing is a PGN parse, and Chess.com sync runs automatically on every
# dashboard load.
#
# NEITHER of the first two may ever carry a NEXT_PUBLIC_ prefix — that prefix
# means "ship this to the browser", and these are the keys that move money.
# There is no publishable key here on purpose: Checkout is Stripe-hosted, so
# the app redirects to a Stripe URL and never renders a card field itself.
STRIPE_SECRET_KEY=

# Verifies that an incoming webhook really came from Stripe. Without it the
# webhook route refuses every event rather than trusting one.
# Local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and use the whsec_... it prints. Production uses a DIFFERENT value, from the
# endpoint you register in the Dashboard — a production secret will reject
# local events and vice versa, which looks like a signature bug.
STRIPE_WEBHOOK_SECRET=

# The recurring Price for the Pro plan (USD 8.00 / month). Create the Product
# and Price in the Stripe Dashboard and paste the price_... id here. With this
# unset the billing page still renders, but upgrading is disabled.
STRIPE_PRICE_ID_PRO=

# Absolute origin used to build Checkout success/cancel and portal return
# URLs. Stripe rejects relative URLs at session-creation time. Set this to the
# real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: mirrors subscription state into a Supabase `subscriptions` table
# so billing can be queried from the Supabase dashboard. Identity still lives
# in Supabase Auth and application data still lives in the local Prisma
# database — this table is a REPORTING COPY, never the source of truth.
#
# Leave it unset and mirroring is simply off; nothing else changes. The mirror
# can never fail a webhook, so an outage or a bad key degrades a dashboard
# table rather than stopping a customer being provisioned.
#
# This is the SERVICE ROLE key (Supabase dashboard → Project Settings → API).
# It bypasses Row Level Security, so it is strictly server-side: never give it
# a NEXT_PUBLIC_ prefix, and never send it to the browser.
#
# Before it will work, create the table by running
# supabase/migrations/20260818210000_subscriptions_mirror.sql in the Supabase
# SQL editor. Then backfill existing accounts with:
#   npx tsx scripts/reconcile-supabase-subscriptions.ts
SUPABASE_SERVICE_ROLE_KEY=
