DATABASE_URL="file:./dev.db"

# Required for real, position-specific AI explanations (Claude Sonnet).
# Without it, every explanation silently falls back to the deterministic
# template provider — the app still works, but explanations get noticeably
# generic and repetitive across unrelated positions. If you notice the same
# sentence appearing verbatim on different moves, check this is actually set
# and check the server logs for "[explain]" warnings.
ANTHROPIC_API_KEY=

# Unlocks the /admin area (signups + waitlist). Must be at least 16
# characters — shorter keys are refused and the admin area stays locked.
# There is deliberately no way to become an admin from inside the app:
# login is password-less, so an account name proves nothing. Leave this
# unset and /admin is closed to everyone, including you.
# Generate one with:  openssl rand -base64 32
ADMIN_KEY=
